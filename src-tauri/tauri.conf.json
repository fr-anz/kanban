{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kanban",
  "version": "0.1.0",
  "identifier": "com.franz.kanban",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "kanban",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2NEU3MDk2MkUzNUFDODcKUldTSHJEVXVsbkJPSnVOZndZY1FTUUlDWkxUZHdVbVNFVHR3REJMamxVVTRZUk1uMVQxYnFFM0YK",
      "endpoints": [
        "https://github.com/fr-anz/kanban/releases/latest/download/latest.json"
      ]
    }
  }
}
